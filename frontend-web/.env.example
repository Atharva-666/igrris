# Igrris AI — Nuxt Frontend Environment Variables
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.

# --------------------------------------------------
# API Base URL
# Local dev:   /api  (Nuxt proxies /api/** → http://localhost:8000/**)
# Production:  https://your-api.up.railway.app  (set this on Vercel)
# --------------------------------------------------
NUXT_PUBLIC_API_BASE=/api

# --------------------------------------------------
# Google OAuth Client ID (public — safe to expose to browser)
# Get from: https://console.cloud.google.com/ → Credentials → OAuth 2.0 Client ID
# Production: set this on Vercel dashboard
# --------------------------------------------------
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
