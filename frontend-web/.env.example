# Igrris AI — Nuxt Frontend Environment
# Copy to .env.local and fill in values as needed.

# URL of the FastAPI backend server.
# During development the Nuxt proxy rewrites /api → http://localhost:8000
# so you can leave NUXT_PUBLIC_API_BASE as /api.
# In production set it to your full API URL, e.g. https://api.yourdomain.com
NUXT_PUBLIC_API_BASE=/api
