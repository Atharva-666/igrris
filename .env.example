# Igrris AI — Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# --------------------------------------------------
# Google OAuth 2.0 Credentials
# Get from: https://console.cloud.google.com/
#   1. Create project → Enable Gmail API
#   2. Credentials → Create OAuth 2.0 Client ID (Web application)
#   3. Authorized redirect URIs → add your REDIRECT_URI below
#   4. Copy Client ID and Client Secret below
# --------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------------------------------------------
# Redirect URI — MUST exactly match what is registered in Google Cloud Console.
#
# In production with Vercel frontend + Render backend:
# The user is redirected to the frontend login catcher: https://<your-frontend-domain>/login
# The frontend catches the code and calls POST /auth/callback on the Render backend.
#
# Local dev:   http://localhost:8501/login  (or http://localhost:8000/auth/callback)
# Production:  https://igrris.vercel.app/login
#
# Register this same URI in Google Cloud Console → OAuth 2.0 Client → Authorized redirect URIs
# --------------------------------------------------
REDIRECT_URI=https://igrris.vercel.app/login

# --------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# Local dev:   http://localhost:8501,http://localhost:3000
# Production:  https://igrris.vercel.app
# --------------------------------------------------
ALLOWED_ORIGINS=https://igrris.vercel.app

# --------------------------------------------------
# Per-user credential storage directory.
# Each authenticated user gets their own <user_id>.json file here.
# Local dev:          leave empty (defaults to <project_root>/credentials/)
# Render (Starter):   /var/data/credentials  (with a Render Persistent Disk mounted at /var/data/credentials)
# Render (Free):      leave empty / default (credentials stored in container filesystem)
# Railway:            /app/credentials  (with a Railway Volume mounted at /app/credentials)
# --------------------------------------------------
# CREDENTIALS_DIR=/var/data/credentials

# --------------------------------------------------
# Session secret — used for future HMAC signing of session tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# --------------------------------------------------
SESSION_SECRET=

# --------------------------------------------------
# Debug mode — set to true for local development only.
# Controls OAUTHLIB_INSECURE_TRANSPORT (allows HTTP OAuth).
# MUST be false in production (Render / Railway HTTPS).
# --------------------------------------------------
DEBUG=false

